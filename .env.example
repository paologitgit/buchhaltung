# Kopiere diese Datei nach .env und trage Deine Keys ein.
# Beide Keys sind OPTIONAL – ohne sie läuft das Tool nur mit OpenStreetMap.

# Google Places API (bessere Abdeckung, findet auch Hochzeitsplaner etc.)
# Anleitung: siehe README, Abschnitt "Google-API-Key einrichten"
GOOGLE_PLACES_API_KEY=

# Claude API (Beschreibungen, Eignungs-Score, bessere Kontakt-Extraktion)
# Anleitung: siehe README, Abschnitt "Claude-API-Key einrichten"
ANTHROPIC_API_KEY=

# Optional: anderes Claude-Modell (Standard: claude-opus-5)
# CLAUDE_MODEL=claude-opus-5
