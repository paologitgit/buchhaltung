# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Database (PostgreSQL)
DB_NAME=buchhaltung
DB_USER=buchhaltung
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# Backup: rclone-Remote-Namen (kommagetrennt), z.B. "gdrive,dropbox".
# Remotes müssen vorher einmalig eingerichtet werden:
#   docker compose exec web rclone config
# Leer lassen = nur lokales Backup (Button "Backup jetzt erstellen" in der App).
BACKUP_RCLONE_REMOTES=
